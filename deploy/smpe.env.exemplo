# Configuracao do SIS SMPE na VPS. O instalar.sh copia este arquivo para deploy/smpe.env (fora do Git).
# Preencha com o banco criado em cPanel > Bancos de dados PostgreSQL (o cPanel poe o nome do usuario na frente).
DATABASE_URL=postgresql://USUARIO_smpe:SENHA_DO_BANCO@localhost:5432/USUARIO_smpe

# Recuperacao de acesso do administrador (opcional). Preencha, reinicie o servico, entre e APAGUE as duas linhas.
#SMPE_RESET_LOGIN=seu.email@dominio.com.br
#SMPE_RESET_SENHA=uma-senha-forte
